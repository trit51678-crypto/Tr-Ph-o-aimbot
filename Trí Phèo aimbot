-- ROTATE TOWARDS LOCKED TARGET
RunService.Heartbeat:Connect(function()
    if not aiming then return end

    local character = player.Character
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    local targetHum = target and target:FindFirstChildOfClass("Humanoid")
    local targetRoot = target and target:FindFirstChild("HumanoidRootPart")

    if not targetHum or targetHum.Health <= 0 or not targetRoot then
        status.Text = "TARGET LOST - TOGGLE AIM"
        return -- Never automatically select another target
    end

    if hum.AutoRotate then
        oldAutoRotate = hum.AutoRotate
        hum.AutoRotate = false
        wasAutoRotateChanged = true
    end

    local position = root.Position
    local targetPosition = targetRoot.Position
    local flatTarget = Vector3.new(
        targetPosition.X,
        position.Y,
        targetPosition.Z
    )

    if (flatTarget - position).Magnitude > 0.01 then
        root.CFrame = CFrame.lookAt(position, flatTarget)
    end
end)

