-- Kéo bảng chính và nút T riêng biệt
local dragData = {}

local function enableDrag(obj, isToggle)
    obj.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch
            and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end

        if isToggle and toggleLocked then return end
        if not isToggle and panelLocked then return end

        dragData[obj] = {
            start = input.Position,
            position = obj.Position,
            input = input
        }
    end)

    UIS.InputChanged:Connect(function(input)
        local data = dragData[obj]
        if not data then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - data.start
            obj.Position = UDim2.new(
                data.position.X.Scale,
                data.position.X.Offset + delta.X,
                data.position.Y.Scale,
                data.position.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragData[obj] = nil
        end
    end)
end

enableDrag(panel, false)
enableDrag(toggle, true)

