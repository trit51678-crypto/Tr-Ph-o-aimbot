-- Tìm mục tiêu gần nhất
local function findNearest()
    local ch = me.Character
    local root = ch and ch:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local best, distance = nil, math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Health > 0 then
            local model = obj.Parent
            local part = model and model:FindFirstChild("HumanoidRootPart")

            if model and model:IsA("Model") and model ~= ch and part then
                local d = (part.Position - root.Position).Magnitude
                if d < distance then
                    best, distance = model, d
                end
            end
        end
    end

    return best
end

local function clearTarget()
    if highlight then highlight:Destroy() end
    highlight, target = nil, nil
end

aimBtn.Activated:Connect(function()
    aim = not aim
    clearTarget()

    if aim then
        target = findNearest()
        if target then
            highlight = Instance.new("Highlight")
            highlight.Adornee = target
            highlight.FillColor = Color3.fromRGB(50, 150, 255)
            highlight.FillTransparency = .8
            highlight.OutlineColor = Color3.new(1, 1, 1)
            highlight.Parent = workspace
        end
    end

    aimBtn.Text = aim and "AIM: ON" or "AIM: OFF"
end)

RunService.Heartbeat:Connect(function()
    if not aim then return end

    local ch = me.Character
    local root = ch and ch:FindFirstChild("HumanoidRootPart")
    local tr = target and target:FindFirstChild("HumanoidRootPart")
    local hum = target and target:FindFirstChildOfClass("Humanoid")

    if not root or not tr or not hum or hum.Health <= 0 then
        aim = false
        clearTarget()
        aimBtn.Text = "AIM: OFF"
        return
    end

    local a, b = root.Position, tr.Position
    local flat = Vector3.new(b.X, a.Y, b.Z)

    if (flat - a).Magnitude > .01 then
        root.CFrame = CFrame.lookAt(a, flat)
    end
end)
